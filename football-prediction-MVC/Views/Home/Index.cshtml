@model football_prediction_MVC.Models.ViewModels.PredictionPageViewModel

@{
    ViewData["Title"] = "Match predictions";
}

<section class="hero">
    <div>
        <span class="eyebrow">Football Prediction ML</span>
        <h1>Predict the match before kickoff.</h1>
        <p class="lead">Enter two teams, leverage Elo context, and get a result with an estimated confidence.</p>
    </div>
    <div class="hero-panel">
        @{
            string Humanize(string raw) =>
                System.Globalization.CultureInfo.CurrentCulture.TextInfo
                    .ToTitleCase(raw.Replace('_', ' ').Replace('-', ' '));
            var topCollections = Model.Stats?.Collections
                .OrderByDescending(c => c.DocumentCount)
                .Take(3)
                .ToList() ?? new List<football_prediction_MVC.Models.Api.CollectionStats>();
            var totalDocs = Model.Stats?.Collections.Sum(c => (long)c.DocumentCount) ?? 0;
        }
        @if (topCollections.Count == 0)
        {
            <div class="hero-stat">
                <span class="label">Dataset</span>
                <strong>Loading&hellip;</strong>
            </div>
            <div class="hero-stat">
                <span class="label">Collections</span>
                <strong>&mdash;</strong>
            </div>
            <div class="hero-stat">
                <span class="label">Status</span>
                <strong>API offline</strong>
            </div>
        }
        else
        {
            foreach (var collection in topCollections)
            {
                <div class="hero-stat">
                    <span class="label">@Humanize(collection.Collection)</span>
                    <strong>@collection.DocumentCount.ToString("N0")</strong>
                </div>
            }
            if (topCollections.Count < 3)
            {
                <div class="hero-stat">
                    <span class="label">Total records</span>
                    <strong>@totalDocs.ToString("N0")</strong>
                </div>
            }
        }
    </div>
</section>

<section class="card-grid">
    <div class="card">
        <h2>Prediction console</h2>
        <p class="muted">Calls the /predict endpoint with the home and away teams.</p>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <form asp-action="Predict" method="post" class="form-grid">
            <div>
                <label class="form-label">Home team</label>
                <input class="form-control" asp-for="HomeTeam" list="team-options" autocomplete="off" placeholder="Start typing a team name" />
            </div>
            <div>
                <label class="form-label">Away team</label>
                <input class="form-control" asp-for="AwayTeam" list="team-options" autocomplete="off" placeholder="Start typing a team name" />
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" type="submit">Run prediction</button>
            </div>
        </form>

        @if (Model.Teams.Count > 0)
        {
            <datalist id="team-options">
                @foreach (var team in Model.Teams)
                {
                    <option value="@team"></option>
                }
            </datalist>
        }
    </div>

    <div class="card card-highlight">
        <h2>Latest result</h2>
        @if (Model.Result == null)
        {
            <p class="muted">Submit a match to see the probabilities and the Elo gap.</p>
        }
        else
        {
            <div class="result-title">@Model.Result.Match</div>
            <div class="result-prediction">@Model.Result.Prediction</div>
            <div class="result-sub">Confidence: @Model.Result.Confidence.ToString("0.0")%</div>

            <div class="metric-grid">
                <div>
                    <span class="label">Home Elo</span>
                    <strong>@Model.Result.HomeElo.ToString("0")</strong>
                </div>
                <div>
                    <span class="label">Away Elo</span>
                    <strong>@Model.Result.AwayElo.ToString("0")</strong>
                </div>
                <div>
                    <span class="label">Delta</span>
                    <strong>@Model.Result.EloDifference.ToString("0")</strong>
                </div>
            </div>

            <div class="probability-bars">
                <div>
                    <span>Home win</span>
                    <div class="bar"><span style="width:@Model.Result.HomeWinProb%"></span></div>
                    <small>@Model.Result.HomeWinProb.ToString("0.0")%</small>
                </div>
                <div>
                    <span>Draw</span>
                    <div class="bar"><span style="width:@Model.Result.DrawProb%"></span></div>
                    <small>@Model.Result.DrawProb.ToString("0.0")%</small>
                </div>
                <div>
                    <span>Away win</span>
                    <div class="bar"><span style="width:@Model.Result.AwayWinProb%"></span></div>
                    <small>@Model.Result.AwayWinProb.ToString("0.0")%</small>
                </div>
            </div>
        }
    </div>
</section>

@if (Model.Result?.Reasoning != null)
{
    var reasoning = Model.Result.Reasoning;
    var homeName = Model.Result.HomeTeam;
    var awayName = Model.Result.AwayTeam;

    <section class="card reasoning-card">
        <h2>Why this prediction</h2>
        @if (!string.IsNullOrWhiteSpace(reasoning.Summary))
        {
            <p class="reasoning-summary">@reasoning.Summary</p>
        }

        @if (reasoning.Factors.Count > 0)
        {
            <div class="factor-grid">
                @foreach (var factor in reasoning.Factors)
                {
                    var favorClass = factor.Favors?.ToLowerInvariant() switch
                    {
                        "home" => "favors-home",
                        "away" => "favors-away",
                        _ => "favors-none"
                    };
                    var favorLabel = factor.Favors?.ToLowerInvariant() switch
                    {
                        "home" => $"Favors {homeName}",
                        "away" => $"Favors {awayName}",
                        _ => "Even"
                    };

                    <div class="factor @favorClass">
                        <div class="factor-head">
                            <span class="factor-label">@factor.Label</span>
                            <span class="factor-badge">@favorLabel</span>
                        </div>
                        <div class="factor-values">
                            <div>
                                <span class="label">@homeName</span>
                                <strong>@factor.HomeValue.ToString("0.##")</strong>
                            </div>
                            <div>
                                <span class="label">@awayName</span>
                                <strong>@factor.AwayValue.ToString("0.##")</strong>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(factor.Description))
                        {
                            <p class="factor-desc">@factor.Description</p>
                        }
                    </div>
                }
            </div>
        }
    </section>
}