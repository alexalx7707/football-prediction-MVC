@model football_prediction_MVC.Models.ViewModels.AdminOpsViewModel

@{
    ViewData["Title"] = "Admin control";
}

<section class="page-header">
    <div>
        <h1>Admin control</h1>
        <p class="lead">Manage dataset imports and monitor training status.</p>
    </div>
    <a class="btn btn-outline-light" asp-controller="Admin" asp-action="Dashboard">Training dashboard</a>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
{
    <div class="alert alert-success">@Model.InfoMessage</div>
}

<section class="card-grid">
    <div class="card">
        <h2>Import dataset</h2>
        <p class="muted">Triggers /data/import and replaces the MongoDB collections.</p>
        <form asp-action="ImportData" method="post">
            <button class="btn btn-primary" type="submit">Import latest dataset</button>
        </form>

        @if (Model.ImportResult != null)
        {
            <div class="result-block">
                <p>@Model.ImportResult.Message</p>
                <div class="stat-grid">
                    <div class="stat-chip">
                        <span>Matches</span>
                        <strong>@Model.ImportResult.MatchesImported</strong>
                    </div>
                    <div class="stat-chip">
                        <span>Elo ratings</span>
                        <strong>@Model.ImportResult.EloRatingsImported</strong>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card">
        <h2>Training status</h2>
        <p class="muted">Live state from /train/status.</p>
        @if (Model.TrainingStatus == null)
        {
            <p class="muted">Status unavailable.</p>
        }
        else
        {
            <div class="status-pill">@Model.TrainingStatus.Status</div>
            <p>@Model.TrainingStatus.Message</p>
        }
    </div>
</section>