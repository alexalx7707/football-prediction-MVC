@model football_prediction_MVC.Models.ViewModels.AdminOpsViewModel

@{
    ViewData["Title"] = "Training dashboard";
}

<section class="page-header">
    <div>
        <h1>Training dashboard</h1>
        <p class="lead">Start training runs and track progress.</p>
    </div>
    <a class="btn btn-outline-light" asp-controller="Admin" asp-action="Index">Admin control</a>
</section>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
{
    <div class="alert alert-success">@Model.InfoMessage</div>
}

<section class="card-grid">
    <div class="card">
        <h2>Start training</h2>
        <p class="muted">Configure the test season and the model complexity.</p>
        <form asp-action="StartTraining" method="post" class="form-grid">
            <div>
                <label class="form-label">Test season</label>
                <input class="form-control" asp-for="TrainingRequest.TestSeason" placeholder="2024/25" />
            </div>
            <div>
                <label class="form-label">XGBoost estimators</label>
                <input class="form-control" asp-for="TrainingRequest.NEstimators" type="number" min="50" max="1000" />
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" type="submit">Run training</button>
            </div>
        </form>

        @if (Model.TrainingResult != null)
        {
            <div class="result-block">
                <p>@Model.TrainingResult.Message</p>
                <div class="metric-grid">
                    <div>
                        <span class="label">RF accuracy</span>
                        <strong>@Model.TrainingResult.AccuracyRf.ToString("0.000")</strong>
                    </div>
                    <div>
                        <span class="label">LR accuracy</span>
                        <strong>@Model.TrainingResult.AccuracyLr.ToString("0.000")</strong>
                    </div>
                    <div>
                        <span class="label">XGB accuracy</span>
                        <strong>@Model.TrainingResult.AccuracyXgb.ToString("0.000")</strong>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card">
        <h2>Current status</h2>
        <p class="muted">Reload the page to refresh.</p>
        @if (Model.TrainingStatus == null)
        {
            <p class="muted">Status unavailable.</p>
        }
        else
        {
            <div class="status-pill">@Model.TrainingStatus.Status</div>
            <p>@Model.TrainingStatus.Message</p>
        }
    </div>
</section>