@page
@model LoginModel
@{
    ViewData["Title"] = "Autentificare";
}

<section class="auth-frame">
    <div class="auth-panel">
        <div class="auth-brand">
            <span class="auth-tag">Predictii Fotbal ML</span>
            <h1>Autentificare</h1>
            <p>Acces rapid la predictii, date istorice si rapoarte de meci.</p>
        </div>
        <form id="account" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="auth-field">
                <label class="form-label" asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nume@exemplu.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="auth-field">
                <label class="form-label" asp-for="Input.Password">Parola</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Parola" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary auth-submit">Autentifica-te</button>
            <a class="auth-link" asp-page="/Account/Register">Nu ai cont? Inregistreaza-te</a>
        </form>
    </div>
    <div class="auth-panel auth-panel-accent">
        <div class="auth-metric">
            <span>Model activ</span>
            <strong>Random Forest + Elo</strong>
        </div>
        <div class="auth-metric">
            <span>Actualizare date</span>
            <strong>Live API</strong>
        </div>
        <div class="auth-metric">
            <span>Insight</span>
            <strong>Predictii explicate</strong>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
